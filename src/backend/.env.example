# ============================================================
# SproutRoute Backend — Environment Variables
# Copy this file to .env for local development
# In production (Railway), set these in the Railway dashboard
# ============================================================

# AI provider. Supported: anthropic, gemini, openai, deepseek.
AI_PROVIDER=anthropic

# Set the key for the selected AI_PROVIDER.
ANTHROPIC_API_KEY=your_api_key_here
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional model overrides.
# ANTHROPIC_MODEL_ID=claude-haiku-4-5-20251001
# GOOGLE_GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL_ID=gpt-5.4-nano
# DEEPSEEK_MODEL_ID=deepseek-chat

# Supabase connection for profiles, metrics, attraction memory, and Trip Hub.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# SUPABASE_SERVICE_ROLE_KEY is also accepted as an alias for SUPABASE_SERVICE_KEY.

# Server Configuration
# PORT is set automatically by Railway in production — do not override it there
PORT=3000
NODE_ENV=development

# CORS Configuration (required in production)
# Comma-separated list of allowed frontend origins
# Local:      leave blank (all localhost origins are allowed automatically)
# Production: set to your Cloudflare Pages URL (and custom domain if you have one)
# Example:    ALLOWED_ORIGINS=https://strollerscout.nitishprasad.com,https://strollerscout.pages.dev
ALLOWED_ORIGINS=

# Google Places API Key (optional — for enhanced destination search)
# Get yours at: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
